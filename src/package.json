{
  "name": "pear-lyrics-overlay",
  "version": "1.0.0",
  "description": "Paroles animées synchronisées avec Pear Desktop",
  "homepage": "https://github.com/qcom-toolbox/Lyrics-Player-GUI",
  "license": "BSD-2-Clause",
  "author": {
    "name": "qcom-toolbox",
    "email": "qcom-toolbox@users.noreply.github.com"
  },
  "desktopName": "pearlyrics.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . PearLyrics --platform=win32 --arch=x64 --out=dist --overwrite --ignore=dist-linux",
    "package:win": "electron-packager . PearLyrics --platform=win32 --arch=x64 --out=dist --overwrite --ignore=dist-linux",
    "package:linux": "electron-builder --linux --publish never",
    "package:mac": "electron-packager . PearLyrics --platform=darwin --arch=universal --out=dist --overwrite --ignore=dist-linux --extend-info=macos-info.plist --ignore=macos-info.plist"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "26.17.0",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "io.github.qcomtoolbox.PearLyrics",
    "productName": "PearLyrics",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "style.css",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist-linux"
    },
    "artifactName": "PearLyrics-${version}-linux-${arch}.${ext}",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "pearlyrics",
      "icon": "icon.png",
      "category": "AudioVideo",
      "synopsis": "Animated synced lyrics for Pear Music Desktop",
      "maintainer": "qcom-toolbox",
      "syncDesktopName": true
    }
  }
}
